# Copy to .env for local development. On Heroku, set each as a config var.

# --- Required ---
# Supabase: Project Settings > Database > Connection string > "Session pooler" (port 5432, IPv4).
# Never use the transaction pooler (port 6543): it breaks the job queue.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Postgres server certificate (PEM). Supabase: Project Settings > Database > SSL configuration > Download certificate, then paste
# the file contents (newlines as \n are fine on Heroku). Required in production so the TLS connection is verified, not just encrypted.
DATABASE_CA=
# Where the site lives. Used for redirects after forms. Must be https in production.
SITE_URL=https://lantle.ai
# Where THIS API is reachable (custom domain on the Heroku app, e.g. CNAME api.lantle.ai). Private edit links, renewal links
# and admin links in emails point here. Required in production; without it those links would point at the static site and 404.
API_BASE_URL=https://api.lantle.ai
SITE_NAME=Lantle
# Your email. Gets every notification. Also the only allowed recipient until EMAIL_DOMAIN_VERIFIED=true.
OWNER_EMAIL=you@example.com
# Admin login at /admin. Use long random strings: at least 16 and 32 characters. Placeholder values are rejected at boot.
ADMIN_PASSWORD=change-me-to-something-long
SESSION_SECRET=change-me-to-32-plus-random-characters

# --- Supabase Storage (thumbnails). Project Settings > API. Bucket must exist and be public. ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=tools

# --- Dodo Payments. Dashboard > Developer > API keys / Webhooks. Products: create them in the dashboard and paste ids. ---
DODO_MODE=test
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_FEATURED=
DODO_PRODUCT_SPONSORED=
DODO_PRODUCT_WRITING_ADDON=
DODO_PRODUCT_DIRECTORY_PACKAGE=
DODO_PRODUCT_INSTANT=

# --- Email (Resend). Until your domain is verified, keep EMAIL_DOMAIN_VERIFIED=false and EMAIL_FROM=onboarding@resend.dev ---
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_DOMAIN_VERIFIED=false

# --- Required in production, optional locally ---
# Cloudflare Turnstile secret. Empty skips the bot check in development; production refuses to boot without it.
TURNSTILE_SECRET=

# --- Optional ---
# Cloudflare Pages > Settings > Builds > Deploy hooks. Approving a tool triggers this.
CF_DEPLOY_HOOK_URL=
# Comma separated origins allowed to call the API from the browser.
ALLOWED_ORIGINS=https://lantle.ai,http://localhost:4321
PORT=3000

# Order builder bundle discount: percent off when two or more different fixed-price items are ordered, and the matching
# percentage discount code created in the Dodo dashboard. Leave the code empty to hold such orders for a manual payment link.
BUNDLE_DISCOUNT_PERCENT=15
DODO_BUNDLE_DISCOUNT_CODE=
# Unpaid orders older than this many days are marked expired by the daily job
PENDING_ORDER_DAYS=14
