    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.0",
    "pg": "^8.13.0",
    "pg-boss": "^10.1.5",
    "resend": "^4.0.0",
    "sharp": "^0.33.5",
